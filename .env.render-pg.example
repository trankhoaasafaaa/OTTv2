# Copy to .env.render-pg on WSL only; never commit the real file.
# Render: put the same entries in service Environment.
NODE_ENV=production
FRONTEND_ORIGIN=https://ottv2-public.vercel.app
# Use the External Database URL, with the query parameters below.
DATABASE_URL=postgresql://USER:PASSWORD@EXTERNAL_HOST:5432/ottv2?sslmode=require&sslaccept=strict&connection_limit=3&connect_timeout=10&pool_timeout=10&socket_timeout=20
ALLOW_SELF_REGISTER=true
# Keep the same worker token already used in .env.worker (64 lowercase hex).
WORKER_TOKEN=REPLACE_WITH_EXISTING_WORKER_TOKEN
